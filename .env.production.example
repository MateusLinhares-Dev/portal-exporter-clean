APP_ENV=production
APP_API_KEY=SUBSTITUA_CHAVE_FORTE
LOG_LEVEL=INFO
PORTAL_ENTRY_URL=https://bpm.falcaobauer.com.br/softexpert/workspace?page=dashboard,ID_REAL
PORTAL_USERNAME=CONTA_TECNICA
PORTAL_PASSWORD=INJETAR_COM_SEGREDO_NAO_GIT
PORTAL_ALLOWED_REPORT_ORIGINS=https://bpm.falcaobauer.com.br,http://medicaotemperatura.falcaobauer.com.br:8082
PORTAL_ROOT_TABS=Obras,CQM,RDF - Civil,RDF - Segurança,RDF - Ambiente,FV - Geral,Inspeção,FIE,FNC,IQ - Lote 2,IQ - Lote 3,IQ - Lote 4
PORTAL_TIMEOUT_MS=30000
PORTAL_MAX_PDF_BYTES=104857600
HISTORICAL_CUTOFF_DATE=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RDS_HOST:5432/DB
NETWORK_SHARE_ROOT=/mnt/client-share
NETWORK_SHARE_REQUIRE_SENTINEL=true
NETWORK_SHARE_SENTINEL_NAME=softexpert-exporter-share.ready
TEMP_DIR=/tmp/softexpert-exporter
WORKER_POLL_SECONDS=5
WORKER_STALE_AFTER_SECONDS=3600
WORKER_JOB_MAX_ATTEMPTS=4
WORKER_JOB_RETRY_SECONDS=60
SCHEDULER_ENABLED=true
SCHEDULER_CRON=0 2 1 1,7 *
SCHEDULER_TIMEZONE=America/Sao_Paulo
APP_IMAGE=COLOQUE_A_IMAGEM_ECR
AWS_REGION=sa-east-1
CLOUDWATCH_LOG_GROUP=/softexpert-exporter/application
